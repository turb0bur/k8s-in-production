{
  "uid": "readonly-rootfs-audit",
  "title": "Read-only root filesystem audit failures",
  "tags": [
    "kyverno",
    "logs"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Violations in the selected period",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"monitoring\", kubernetes.container_name=\"event-exporter\"} reason:PolicyViolation readOnlyRootFilesystem | extract \"<kind> <ns>/<pod>: fail;\" from message | filter kind:=Pod | stats count() violations",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Violations by namespace",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"monitoring\", kubernetes.container_name=\"event-exporter\"} reason:PolicyViolation readOnlyRootFilesystem | extract \"<kind> <ns>/<pod>: fail;\" from message | filter kind:=Pod | stats by (ns) count() violations",
          "queryType": "statsRange",
          "legendFormat": "{{ns}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Pods that failed the audit",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"monitoring\", kubernetes.container_name=\"event-exporter\"} reason:PolicyViolation readOnlyRootFilesystem | extract \"<kind> <ns>/<pod>: fail;\" from message | filter kind:=Pod | stats by (ns, pod) count() violations | sort by (violations desc)",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Event exporter log (raw events)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"monitoring\", kubernetes.container_name=\"event-exporter\"} reason:PolicyViolation readOnlyRootFilesystem | sort by (_time desc)",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}